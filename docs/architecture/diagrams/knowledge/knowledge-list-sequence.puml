@startuml
title Knowledge 时序：知识库列表查询（单用例）

' Scope:
' - 查询知识库列表，按 INDEXED 文档聚合统计
' Not in scope:
' - 上传受理、分块预览与问答生成
' See also:
' - ./knowledge-boundary.puml
' - ../ingest/shared/ingest-shared-er-domain.puml

actor Client
participant "KnowledgeBaseController" as C
participant "ListKnowledgeBasesUseCase" as U
participant "KnowledgeBaseQueryRepository" as R
database "PostgreSQL" as PG

Client -> C : GET /knowledge-bases
C -> U : handle()
U -> R : listIndexedKnowledgeBases()
R -> PG : SELECT kb_id, COUNT(*)\nWHERE status='INDEXED'\nGROUP BY kb_id
PG --> R : aggregated rows
R --> U : kb stats list
U --> C : knowledge-base results
C --> Client : 200 + id/name/indexedDocumentCount

@enduml
